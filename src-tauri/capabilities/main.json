{
  "identifier": "main",
  "description": "Local board and user-operated terminal commands for the main window.",
  "windows": ["main"],
  "permissions": [
    "allow-get-board",
    "allow-create-thread",
    "allow-mutate-board",
    "allow-refresh-threads",
    "allow-read-thread",
    "allow-mark-thread-read",
    "allow-open-in-zed",
    "allow-send-message",
    "allow-list-models",
    "allow-stop-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "allow-steer-message",
    "allow-respond-to-request",
    "allow-fork-thread",
    "allow-update-thread",
    "allow-terminal-open",
    "allow-terminal-write",
    "allow-terminal-resize",
    "allow-terminal-close"
  ]
}
